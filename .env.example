# Documento 110 — variáveis de ambiente do docker-compose
# Copie para .env (mesma pasta) e preencha. NUNCA comitar o .env real.
#   cp .env.example .env

# Chave de criptografia do n8n (credenciais salvas). OBRIGATÓRIA e fixa —
# se mudar depois, o n8n perde acesso às credenciais já salvas.
# Gere com:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Chave para autenticar chamadas à Evolution API (header apikey).
# Qualquer string forte. Gere com:  openssl rand -hex 24
EVOLUTION_API_KEY=

# Sinais atmosfericos reais. No ADS, crie a conta, aceite os termos do
# dataset CAMS e copie a configuração exibida pelo portal para ~/.cdsapirc
# com permissão 0600. Para GES DISC, configure Earthdata Login em ~/.netrc
# com permissão 0600. Nenhum segredo pertence ao repositório ou ao .env.
SENTINELA_SIGNAL_INTERVAL_HOURS=6
SENTINELA_SIGNAL_WINDOW_HOURS=24
SENTINELA_SIGNAL_TIMEOUT_SECONDS=30
SENTINELA_RESEARCHER_ID=hl
SENTINELA_CAMS_DATASET=cams-global-atmospheric-composition-forecasts
SENTINELA_CAMS_THRESHOLD=0.2
SENTINELA_CAMS_FORECAST_HOURS=0,6,12,18,24
SENTINELA_CAMS_REGION=all
SENTINELA_CAMS_VARIABLE=dust_aerosol_optical_depth_550nm
NASA_CMR_API_URL=https://cmr.earthdata.nasa.gov/search
SENTINELA_CMR_PAGE_SIZE=20
SENTINELA_CMR_CALIPSO_COLLECTION_IDS=C3551627908-LARC_CLOUD
SENTINELA_CMR_MODIS_COLLECTION_IDS=C1443533440-LAADS
SENTINELA_MERRA2_COLLECTION=C1276812830-GES_DISC
SENTINELA_MERRA2_VARIABLE=DUEXTTAU
SENTINELA_MERRA2_THRESHOLD=0.2
SENTINELA_MERRA2_REGION=all
SENTINELA_MERRA2_MAX_LATENCY_HOURS=1080

# USGS Earthquake Catalog (sem chave)
SENTINELA_USGS_MIN_MAGNITUDE=4.5
SENTINELA_USGS_LOOKBACK_HOURS=24
SENTINELA_USGS_LIMIT=200

# Open-Meteo Weather (sem chave)
SENTINELA_WEATHER_LOCATIONS=vitoria_es:-20.3155,-40.3128;south_atlantic:-25.0,-20.0;namibia_coast:-23.0,14.5;israel:31.5,34.8
SENTINELA_WEATHER_FORECAST_HOURS=48
SENTINELA_WEATHER_WIND_GUST_THRESHOLD_KMH=70
SENTINELA_WEATHER_PRECIPITATION_THRESHOLD_MM_H=30
SENTINELA_WEATHER_VISIBILITY_THRESHOLD_M=3000
SENTINELA_WEATHER_TEMPERATURE_HIGH_C=40
SENTINELA_WEATHER_TEMPERATURE_LOW_C=0

# Open-Meteo Marine (sem chave)
SENTINELA_MARINE_LOCATIONS=espirito_santo_coast:-20.5,-39.5;south_atlantic:-25.0,-20.0;namibia_coast:-23.0,13.5;eastern_mediterranean:32.0,34.5
SENTINELA_MARINE_FORECAST_HOURS=48
SENTINELA_MARINE_WAVE_HEIGHT_THRESHOLD_M=3.0
SENTINELA_MARINE_SWELL_HEIGHT_THRESHOLD_M=2.5
SENTINELA_MARINE_WAVE_PERIOD_THRESHOLD_S=14

# Open-Meteo Climate Change API (sem chave). Simulação/projeção CMIP6
# HighResMIP corrigida com ERA5-Land; não representa observações históricas.
SENTINELA_CLIMATE_LOCATIONS=southeast_brazil:-20.3155,-40.3128;amazon_basin:-3.1190,-60.0217;namibia:-22.5609,17.0658;angola:-8.8390,13.2894;israel:31.5,34.8;eastern_mediterranean:34.9,33.0
SENTINELA_CLIMATE_MODEL=EC_Earth3P_HR
SENTINELA_CLIMATE_BASELINE_START=1991-01-01
SENTINELA_CLIMATE_BASELINE_END=2020-12-31
SENTINELA_CLIMATE_TARGET_START=2040-01-01
SENTINELA_CLIMATE_TARGET_END=2049-12-31
SENTINELA_CLIMATE_TEMPERATURE_ANOMALY_THRESHOLD_C=2.0
SENTINELA_CLIMATE_PRECIPITATION_ANOMALY_THRESHOLD_FRACTION=0.25
SENTINELA_CLIMATE_PRECIPITATION_ANOMALY_THRESHOLD_MM=20.0
SENTINELA_CLIMATE_PRECIPITATION_MIN_BASELINE_MM=20.0

# NOAA CO-OPS (sem chave). Cobertura primaria: costas dos EUA e territorios.
# Estacoes JSON opcionais: id, name, latitude, longitude, products, datum,
# current_bin e temperature_baseline_c. Sem baseline nao ha anomalia termica.
SENTINELA_COOPS_STATIONS_JSON=
SENTINELA_COOPS_LOOKBACK_HOURS=24
SENTINELA_COOPS_WATER_LEVEL_THRESHOLD_M=1.0
SENTINELA_COOPS_CURRENT_THRESHOLD_MS=1.0
SENTINELA_COOPS_TEMP_ANOMALY_C=3.0

# NOAA NDBC realtime2 (sem chave). Estacoes iniciais explicitas: 41013, 41043, 41121.
SENTINELA_NDBC_STATIONS_JSON=
SENTINELA_NDBC_LOOKBACK_HOURS=24
SENTINELA_NDBC_WAVE_HEIGHT_THRESHOLD_M=3.0
SENTINELA_NDBC_SWELL_PERIOD_THRESHOLD_S=14.0
SENTINELA_NDBC_WIND_THRESHOLD_MS=17.2

# NOAA/NWS API (sem chave). User-Agent obrigatório pela documentação oficial.
SENTINELA_NWS_USER_AGENT=(sentinela-hl, https://github.com/henriquelobog-br/sentinela-hl)

# NASA DONKI. DEMO_KEY é permitido apenas para ensaio controlado.
NASA_API_KEY=DEMO_KEY
SENTINELA_DONKI_LOOKBACK_DAYS=3

# USGS HANS / Smithsonian GVP (sem chave)
SENTINELA_VOLCANO_LOOKBACK_HOURS=72
SENTINELA_GVP_FEATURE_COUNT=2000

# GDELT 2.0 (sem chave)
SENTINELA_GDELT_MIN_SOURCES=2
SENTINELA_GDELT_MIN_MENTIONS=3
SENTINELA_GDELT_LOOKBACK_MINUTES=60
SENTINELA_GDELT_MAX_GROUPS=12

# ACLED (OAuth; credenciais da conta myACLED)
SENTINELA_ACLED_USERNAME=
SENTINELA_ACLED_PASSWORD=
SENTINELA_ACLED_LOOKBACK_DAYS=3
SENTINELA_ACLED_LIMIT=5000

# NASA FIRMS (solicite uma MAP_KEY gratuita)
SENTINELA_FIRMS_MAP_KEY=
SENTINELA_FIRMS_DAY_RANGE=1
SENTINELA_FIRMS_VOLCANO_RADIUS_KM=25
SENTINELA_FIRMS_MAX_CLUSTERS=50
# Identidade da ocorrência: região + data UTC + célula desta grade estável.
SENTINELA_FIRMS_OCCURRENCE_GRID_DEGREES=0.15
SENTINELA_FIRMS_MAX_CLUSTERS_PER_REGION=10
# JSON opcional: {"region_id":[west,south,east,north]}
SENTINELA_FIRMS_REGION_BOXES=
